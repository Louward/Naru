# .env.example 을 .env 로 복사해서 사용하세요

PORT=3000

# ---------- DB ----------
# 전체 주소를 쓰거나 (로컬 MongoDB 예: mongodb://127.0.0.1:27017/naru)
MONGODB_URI=
# 기존 Atlas 설정을 쓰려면 MONGODB_URI를 비우고 아래를 채우세요
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=myDatabase

# ---------- 대화 ----------
# 캐릭터가 부를 내 이름
USER_NAME=사용자

# ---------- AI ----------
# 기본 AI: claude | codex | ollama (캐릭터 파일에서 캐릭터별로 바꿀 수 있음)
LLM_PROVIDER=claude
# 대화 요약용 AI. 구독 사용량을 아끼려면 ollama 추천. 비우면 기본 AI 사용
SUMMARY_PROVIDER=
LLM_TIMEOUT_MS=180000

# Claude Code CLI (claude 로그인 필요)
CLAUDE_COMMAND=claude
# sonnet / opus / haiku 등. 비우면 CLI 기본값
CLAUDE_MODEL=sonnet

# Codex CLI (codex 로그인 필요)
CODEX_COMMAND=codex
CODEX_MODEL=
# 낮을수록 빠름: minimal | low | medium | high
CODEX_REASONING_EFFORT=low

# Ollama (ollama list 에 있는 모델 이름)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3
OLLAMA_NUM_CTX=8192

# ---------- 기억(대화 요약) ----------
# 요약 안 된 메시지가 이 개수를 넘으면 오래된 것부터 요약
MEMORY_COMPACT_THRESHOLD=40
# 요약 후에도 원문으로 남길 최근 메시지 수
MEMORY_KEEP_RECENT=20
MEMORY_SUMMARY_MAX_CHARS=2000
